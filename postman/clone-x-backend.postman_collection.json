  },
  "item": [
    {
      "name": "Feed",
      "item": [
        {
          "name": "Get Feed List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each feed has id, userId, content, createdAt', function () {",
                  "  pm.response.json().forEach(function (feed) {",
                  "    pm.expect(feed).to.have.all.keys('id', 'userId', 'content', 'createdAt');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/feed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feed"
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/feed",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "feed"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
